local TeleportToolName = "Ferramenta de Teleporte";
local TeleportTool = nil;

local function RemoveTeleportTool()
    for _, container in ipairs({LocalPlayer.Backpack, LocalPlayer.Character}) do
        if container then
            local existing = container:FindFirstChild(TeleportToolName);
            if existing then
                existing:Destroy();
            end;
        end;
    end;
    TeleportTool = nil;
end;

local function CreateTeleportTool()
    RemoveTeleportTool();

    local tool = Instance.new("Tool");
    tool.Name = TeleportToolName;
    tool.ToolTip = "Clique para se teleportar";
    tool.RequiresHandle = false;
    tool.CanBeDropped = false;

    local equippedMouse = nil;
    local lastTouchPosition = nil;
    local touchConnection = nil;

    local function getTargetPosition()
        if equippedMouse and equippedMouse.Hit then
            return equippedMouse.Hit.Position;
        end;

        if lastTouchPosition and WorkspaceService.CurrentCamera then
            local camera = WorkspaceService.CurrentCamera;
            local ray = camera:ViewportPointToRay(lastTouchPosition.X, lastTouchPosition.Y);
            local params = RaycastParams.new();
            params.FilterType = Enum.RaycastFilterType.Exclude;
            params.FilterDescendantsInstances = {LocalPlayer.Character};

            local result = WorkspaceService:Raycast(ray.Origin, ray.Direction * 1000, params);
            return result and result.Position or (ray.Origin + ray.Direction * 100);
        end;

        return nil;
    end;

    tool.Equipped:Connect(function(mouse)
        equippedMouse = mouse;
        lastTouchPosition = nil;

        if touchConnection then
            touchConnection:Disconnect();
        end;

        touchConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if not gameProcessed and input.UserInputType == Enum.UserInputType.Touch then
                lastTouchPosition = input.Position;
            end;
        end);
    end);

    tool.Unequipped:Connect(function()
        equippedMouse = nil;
        lastTouchPosition = nil;

        if touchConnection then
            touchConnection:Disconnect();
            touchConnection = nil;
        end;
    end);

    tool.Activated:Connect(function()
        local character = LocalPlayer.Character;
        local root = character and character:FindFirstChild("HumanoidRootPart");
        local targetPosition = getTargetPosition();

        if root and targetPosition then
            pcall(function()
                root.CFrame = CFrame.new(targetPosition + Vector3.new(0, 3, 0));
            end);
        end;
    end);

    tool.Parent = LocalPlayer.Backpack;
    TeleportTool = tool;
end;

local TeleportToggle = EquipmentTab:Toggle({
