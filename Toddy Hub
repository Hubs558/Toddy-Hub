-- Auto Shot helpers: kept separate from the removed Kill All features.
local AutoShotRaycastParams = RaycastParams.new()
AutoShotRaycastParams.IgnoreWater = true
AutoShotRaycastParams.FilterType = Enum.RaycastFilterType.Blacklist

local function AutoShotFindTool(animationName)
    local character = LocalPlayer and LocalPlayer.Character
    if not character then return nil end
    local fallback
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then
            if item:GetAttribute("EquipAnimation") == animationName then
                return item
            end
            if not fallback and item:FindFirstChild("Muzzle", true) then
                fallback = item
            end
        end
    end
    return fallback
end

local function AutoShotHasLineOfSight(targetPart, origin)
    local character = LocalPlayer and LocalPlayer.Character
    if not character or not targetPart then return false end
    AutoShotRaycastParams.FilterDescendantsInstances = {character}
    local direction = targetPart.Position - origin
    if direction.Magnitude <= 0 then return true end
    local hit = WorkspaceService:Raycast(origin, direction.Unit * direction.Magnitude, AutoShotRaycastParams)
    return not hit or hit.Instance:IsDescendantOf(targetPart.Parent)
end

local function AutoShotFindTarget(originPart)
    local closestPlayer, closestRoot
    local bestDistance = MaxDistance + 1
    local gun = AutoShotFindTool(GunConfig.GUN)
    if not gun then return nil, nil end
    local muzzle = gun:FindFirstChild("Muzzle", true)
    if not muzzle then return nil, nil end
    for _, candidate in ipairs(PlayerService1:GetPlayers()) do
        if candidate ~= LocalPlayer and candidate.Character and candidate.Character.Parent
            and (not candidate.Team or not LocalPlayer.Team or candidate.Team ~= LocalPlayer.Team) then
            local character = candidate.Character
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            local root = character:FindFirstChild("HumanoidRootPart")
            if humanoid and humanoid.Health > 0 and root then
                local distance = (root.Position - originPart.Position).Magnitude
                if distance < bestDistance and distance <= MaxDistance then
                    bestDistance = distance
                    closestPlayer, closestRoot = candidate, root
                end
            end
        end
    end
    return closestPlayer, closestRoot
end

local function AutoShotFire(targetRoot, animator)
    local gun = AutoShotFindTool(GunConfig.GUN)
    if not gun or not targetRoot or not targetRoot:IsDescendantOf(WorkspaceService) then return end
    local muzzle = gun:FindFirstChild("Muzzle", true)
    if not muzzle then return end
    local origin = muzzle.WorldPosition
    local targetPosition = targetRoot.Position + Vector3.new(0, 2, 0)
    if animator and ShootAnimation then pcall(function() animator:LoadAnimation(ShootAnimation):Play() end) end
    local fireSound = gun:FindFirstChild("Fire")
    if fireSound then pcall(function() fireSound:Play() end) end
    if BulletRenderer then pcall(BulletRenderer, origin, targetPosition, "Default") end
    if AutoShotHasLineOfSight(targetRoot, origin) and ShootGunRemote then
        pcall(function() ShootGunRemote:FireServer(origin, targetPosition, targetRoot, targetPosition) end)
    end
end

